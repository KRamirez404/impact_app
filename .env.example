JWT_SECRET_KEY=replace-with-a-long-random-secret

# Wompi Sandbox (opcional para desarrollo local)
WOMPI_ENV=sandbox
WOMPI_ALLOW_PRODUCTION=0
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_MIN_AMOUNT=1000
DONATION_REDIRECT_URL=https://transaction-redirect.wompi.co/check
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Transferencias bancarias manuales (deshabilitadas por defecto)
TRANSFERENCIAS_ENABLED=0
FINANCIAL_ASSIGNMENTS_ENABLED=0
FINANCIAL_ADMIN_USER_ID=
# Ruta absoluta fuera de uploads; Docker Compose usa /app/private_uploads.
PRIVATE_STORAGE_ROOT=
TRANSFER_RECEIPT_MAX_BYTES=8388608
TRANSFER_MIN_AMOUNT=1000
# Generar fuera del repositorio; no versionar estas claves.
BANK_ACCOUNT_ENCRYPTION_KEY=
BANK_ACCOUNT_ENCRYPTION_KEY_OLD=
BANK_ACCOUNT_HASH_KEY=

# Notificaciones por correo (deshabilitadas por defecto)
MAIL_ENABLED=0
# smtp | brevo
MAIL_PROVIDER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=ImpactApp
MAIL_TIMEOUT=10
# Proveedor por API HTTPS (Brevo)
MAIL_API_KEY=
MAIL_API_URL=
MAIL_API_TIMEOUT=10
MAIL_MAX_ATTEMPTS=3

# Postgres local para ejecutar el backend fuera de Docker (docker compose publica 127.0.0.1:5432)
DATABASE_URL=postgresql+psycopg2://impactapp:impactapp@localhost:5432/impactapp
