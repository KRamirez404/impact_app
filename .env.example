JWT_SECRET_KEY=replace-with-a-long-random-secret

# Wompi Sandbox (opcional para desarrollo local)
WOMPI_ENV=sandbox
WOMPI_ALLOW_PRODUCTION=0
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_MIN_AMOUNT=1000
DONATION_REDIRECT_URL=https://transaction-redirect.wompi.co/check
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Postgres local para ejecutar el backend fuera de Docker (docker compose publica 127.0.0.1:5432)
DATABASE_URL=postgresql+psycopg2://impactapp:impactapp@localhost:5432/impactapp
