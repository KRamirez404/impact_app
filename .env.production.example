# Copia este archivo a .env.production y completa los valores reales.
# NUNCA subas .env.production al repositorio.

# Dominio público (debe apuntar al VPS y coincidir con API_BASE_URL)
DOMAIN=app.impactapp.co
API_BASE_URL=https://app.impactapp.co/api
ALLOWED_ORIGINS=https://app.impactapp.co
DONATION_REDIRECT_URL=https://transaction-redirect.wompi.co/check

# Base de datos PostgreSQL
POSTGRES_DB=impactapp
POSTGRES_USER=impactapp
POSTGRES_PASSWORD=cambia-esta-clave

# Secreto JWT estable (genera uno largo y aleatorio; no rotar sin migrar checksums)
JWT_SECRET_KEY=cambia-por-un-secreto-largo-y-aleatorio

# Wompi - Sandbox (cambia a llaves y URLs de producción cuando actives la cuenta)
WOMPI_ENV=sandbox
WOMPI_ALLOW_PRODUCTION=0
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_MIN_AMOUNT=1000

# Transferencias bancarias (mantener deshabilitadas hasta completar la revisión)
TRANSFERENCIAS_ENABLED=0
FINANCIAL_ASSIGNMENTS_ENABLED=0
FINANCIAL_ADMIN_USER_ID=
PRIVATE_STORAGE_ROOT=/app/private_uploads
TRANSFER_RECEIPT_MAX_BYTES=8388608
TRANSFER_MIN_AMOUNT=1000
# Generar fuera del repositorio y no versionar.
BANK_ACCOUNT_ENCRYPTION_KEY=
BANK_ACCOUNT_ENCRYPTION_KEY_OLD=
BANK_ACCOUNT_HASH_KEY=

# Producción Wompi (referencia; no activar hasta autorización humana)
# Ver docs/wompi_produccion.md. Cambiar WOMPI_ALLOW_PRODUCTION a 1 solo en la
# ventana autorizada, después de configurar llaves y URL de eventos productivas.
# WOMPI_ENV=production
# WOMPI_ALLOW_PRODUCTION=1
# WOMPI_PUBLIC_KEY=pub_prod_...
# WOMPI_PRIVATE_KEY=prv_prod_...
# WOMPI_INTEGRITY_SECRET=prod_integrity_...
# WOMPI_EVENTS_SECRET=prod_events_...
# WOMPI_API_URL=https://production.wompi.co/v1
